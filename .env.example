# Converge. Copy to .env and fill in.

# Postgres
POSTGRES_DB=converge
POSTGRES_USER=converge
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://converge:change-me@converge-db:5432/converge

# 32 random bytes, base64 (`make secret`). Encrypts connection credentials.
# Never change it once a connection is saved: those would become unreadable.
CONVERGE_SECRET_KEY=

# How people reach it, for invite links.
CONVERGE_PUBLIC_URL=https://converge.example.com

# Behind Traefik: trust the X-Forwarded-For entry it adds (login throttling).
CONVERGE_BEHIND_PROXY=true

# Only for plain-http LAN setups; browsers drop Secure cookies over http.
# CONVERGE_COOKIE_SECURE=false

# Prometheus /metrics on 9090 (never through Traefik). A token when the
# port is published for a Prometheus on another host.
# CONVERGE_METRICS_TOKEN=

RUST_LOG=info
